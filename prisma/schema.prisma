// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MIEMBRO
  ENTRENADOR
  RECEPCION_ADMIN

  @@map("user_role")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String   @default("")
  role         UserRole @default(MIEMBRO)
  cardNumber   String?  @unique @map("card_number")
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  reservations     Reservation[]
  trainedSessions  ClassSession[]    @relation("ClassTrainer")
  memberships      Membership[]
  trainerSlots     TrainerSlot[]
  personalSessions PersonalSession[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------
// H4 — Reserva de cupo en una clase (DB-4.1)
// ---------------------------------------------------------------

enum ReservationStatus {
  Activa
  Cancelada

  @@map("reservation_status")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  sessionId   String            @map("session_id") @db.Uuid
  memberId    String            @map("member_id") @db.Uuid
  status      ReservationStatus @default(Activa)
  createdAt   DateTime          @default(now()) @map("created_at")
  cancelledAt DateTime?         @map("cancelled_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  User         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Una reserva por miembro y sesión (si cancela y reserva de nuevo, se reactiva)
  @@unique([sessionId, memberId])
  @@index([memberId])
  @@index([sessionId, status])
  @@map("reservations")
}

enum ClassSessionStatus {
  Programada
  Cancelada
  Finalizada

  @@map("class_session_status")
}

model ClassSession {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  trainerId   String             @map("trainer_id") @db.Uuid
  startsAt    DateTime           @map("starts_at")
  durationMin Int                @map("duration_min")
  capacity    Int
  status      ClassSessionStatus @default(Programada)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  trainer      User          @relation("ClassTrainer", fields: [trainerId], references: [id])
  reservations Reservation[]

  @@index([startsAt])
  @@map("class_sessions")
}

enum PlanType {
  MENSUAL
  TRIMESTRAL
  CLASES_SUELTAS

  @@map("plan_type")
}

model Plan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  type         PlanType
  price        Decimal      @db.Decimal(6, 2)
  durationDays Int?         @map("duration_days")
  classCount   Int?         @map("class_count")
  benefits     String?
  isActive     Boolean      @default(true) @map("is_active")
  memberships  Membership[]

  @@map("plans")
}

model Membership {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  remainingClasses Int?      @map("remaining_classes")
  createdAt        DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  plan    Plan     @relation(fields: [planId], references: [id])
  charges Charge[]

  @@index([userId, createdAt])
  @@map("memberships")
}

enum SessionStatus {
  Agendada
  Completada
  Cancelada

  @@map("session_status")
}

// ---------------------------------------------------------------
// H7 — Bloques de disponibilidad del entrenador (DB-7.1)
// ---------------------------------------------------------------

model TrainerSlot {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  trainer         User             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  personalSession PersonalSession?

  @@unique([trainerId, date, startTime])
  @@index([trainerId])
  @@index([date])
  @@map("trainer_slots")
}

// ---------------------------------------------------------------
// H8 — Sesión personal agendada sobre un bloque (DB-8.1)
// ---------------------------------------------------------------

model PersonalSession {
  id        String        @id @default(uuid()) @db.Uuid
  slotId    String        @unique @map("slot_id") @db.Uuid
  memberId  String        @map("member_id") @db.Uuid
  status    SessionStatus @default(Agendada)
  createdAt DateTime      @default(now()) @map("created_at")

  slot   TrainerSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  member User        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  charge Charge?

  @@index([memberId])
  @@map("personal_sessions")
}

enum ChargeStatus {
  Pendiente
  Pagada
  Anulada

  @@map("charge_status")
}

/// Cobro generado por una compra/renovación de membresía o por una sesión personal.
model Charge {
  id                String       @id @default(uuid()) @db.Uuid
  membershipId      String?      @map("membership_id") @db.Uuid
  personalSessionId String?      @unique @map("personal_session_id") @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  status            ChargeStatus @default(Pendiente)
  createdAt         DateTime     @default(now()) @map("created_at")

  membership      Membership?      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  personalSession PersonalSession? @relation(fields: [personalSessionId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@map("charges")
}
