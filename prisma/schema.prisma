// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  role         UserRole @default(MIEMBRO)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  reservations    Reservation[]
  trainedSessions ClassSession[] @relation("ClassTrainer")
  memberships     Membership[]
  machineStatusLogs MachineStatusLog[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------
// H4 — Reserva de cupo en una clase (DB-4.1)
// ---------------------------------------------------------------

enum ReservationStatus {
  Activa
  Cancelada

  @@map("reservation_status")
}

enum UserRole {
  ADMINISTRADOR
  ENTRENADOR
  MIEMBRO

  @@map("user_role")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  sessionId   String            @map("session_id") @db.Uuid
  memberId    String            @map("member_id") @db.Uuid
  status      ReservationStatus @default(Activa)
  createdAt   DateTime          @default(now()) @map("created_at")
  cancelledAt DateTime?         @map("cancelled_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  User         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Una reserva por miembro y sesión (si cancela y reserva de nuevo, se reactiva)
  @@unique([sessionId, memberId])
  @@index([memberId])
  @@index([sessionId, status])
  @@map("reservations")
}

enum MachineStatus {
  OPERATIVA
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO

  @@map("machine_status")
}

model Machine {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @unique
  status        MachineStatus   @default(OPERATIVA)
  reason        String?
  updatedAt     DateTime        @updatedAt @map("updated_at")
  statusLogs    MachineStatusLog[]

  @@index([name])
  @@map("machines")
}

model MachineStatusLog {
  id             String        @id @default(uuid()) @db.Uuid
  machineId      String        @map("machine_id") @db.Uuid
  previousStatus MachineStatus? @map("previous_status")
  newStatus      MachineStatus @map("new_status")
  reason         String?
  changedById    String        @map("changed_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([machineId, createdAt])
  @@map("machine_status_logs")
}

enum ClassSessionStatus {
  Programada
  Cancelada
  Finalizada

  @@map("class_session_status")
}

model ClassSession {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  trainerId   String             @map("trainer_id") @db.Uuid
  startsAt    DateTime           @map("starts_at")
  durationMin Int                @map("duration_min")
  capacity    Int
  status      ClassSessionStatus @default(Programada)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  trainer      User          @relation("ClassTrainer", fields: [trainerId], references: [id])
  reservations Reservation[]

  @@index([startsAt])
  @@map("class_sessions")
}

enum PlanType {
  MENSUAL
  TRIMESTRAL
  CLASES_SUELTAS

  @@map("plan_type")
}

model Plan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  type         PlanType
  price        Decimal      @db.Decimal(6, 2)
  durationDays Int?         @map("duration_days")
  classCount   Int?         @map("class_count")
  isActive     Boolean      @default(true) @map("is_active")
  memberships  Membership[]

  @@map("plans")
}

model Membership {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  remainingClasses Int?      @map("remaining_classes")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
  @@map("memberships")
}