// Documentación: https://www.prisma.io/docs

generator client {
  provider               = "prisma-client-js"
  output                 = "../src/generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MIEMBRO
  ENTRENADOR
  RECEPCION_ADMIN

  @@map("user_role")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(MIEMBRO)
  name         String?  @db.VarChar(50)
  surname      String?  @db.VarChar(50)
  cardNumber   String?  @unique @map("card_number") @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  memberships   Membership[]
  charges       Charge[]       @relation("UserCharges")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------
// H1 & H2 — Membresías, Planes y Cobros (Task DB-1.1 / DB-2.1)
// ---------------------------------------------------------------

enum PlanType {
  MENSUAL
  TRIMESTRAL
  CLASES_SUELTAS

  @@map("plan_type")
}

enum MembershipStatus {
  VIGENTE
  VENCIDA

  @@map("membership_status")
}

enum ChargeStatus {
  PENDIENTE
  PAGADO
  ANULADO

  @@map("charge_status")
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  type         PlanType
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int?     @map("duration_days")
  classCount   Int?     @map("class_count")
  benefits     String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  charges     Charge[]

  @@map("plans")
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  planId           String           @map("plan_id") @db.Uuid
  status           MembershipStatus @default(VIGENTE)
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  remainingClasses Int?             @map("remaining_classes")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges Charge[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("memberships")
}

model Charge {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  planId        String       @map("plan_id") @db.Uuid
  membershipId  String?      @map("membership_id") @db.Uuid
  amount        Decimal      @db.Decimal(10, 2)
  status        ChargeStatus @default(PENDIENTE)
  receiptNumber String?      @unique @map("receipt_number") @db.VarChar(30)
  concept       String?      @db.VarChar(150)
  last4         String?      @db.VarChar(4)
  paidAt        DateTime?    @map("paid_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user       User        @relation("UserCharges", fields: [userId], references: [id], onDelete: Cascade)
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([createdAt])
  @@map("charges")
}