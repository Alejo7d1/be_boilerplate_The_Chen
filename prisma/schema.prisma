// Documentación: https://www.prisma.io/docs

generator client {
  provider              = "prisma-client"
  output                = "../src/generated/prisma"
  engineType            = "client"
  runtime               = "nodejs"
  moduleFormat          = "esm"
  generatedFileExtension = "ts"
  importFileExtension   = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MIEMBRO
  ENTRENADOR
  RECEPCION_ADMIN

  @@map("user_role")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  role         UserRole     @default(MIEMBRO)
  name         String?      @db.VarChar(50)
  surname      String?      @db.VarChar(50)
  cardNumber   String?      @unique @map("card_number") @db.VarChar(30)
  passwordHash String       @map("password_hash")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  memberships      Membership[]
  charges          Charge[]          @relation("UserCharges")
  reservations     Reservation[]     @relation("UserReservations")
  trainerSessions  ClassSession[]    @relation("TrainerSessions")
  trainedSessions  ClassSession[]    @relation("ClassTrainer")
  trainerSlots     TrainerSlot[]
  personalSessions PersonalSession[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------
// H1, H2 & H3 — Membresías, Planes y Cobros (Task DB-1.1 / DB-2.1 / DB-3.1)
// ---------------------------------------------------------------

enum PlanType {
  MENSUAL
  TRIMESTRAL
  CLASES_SUELTAS

  @@map("plan_type")
}

enum MembershipStatus {
  VIGENTE
  VENCIDA

  @@map("membership_status")
}

enum ChargeStatus {
  PENDIENTE
  PAGADO
  ANULADO

  @@map("charge_status")
}

model Plan {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @unique @db.VarChar(50)
  type         PlanType
  price        Decimal     @db.Decimal(10, 2)
  durationDays Int?        @map("duration_days")
  classCount   Int?        @map("class_count")
  benefits     String?
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  memberships Membership[]
  charges     Charge[]

  @@map("plans")
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  planId           String           @map("plan_id") @db.Uuid
  status           MembershipStatus @default(VIGENTE)
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  remainingClasses Int?             @map("remaining_classes")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges Charge[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("memberships")
}

model Charge {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  planId        String       @map("plan_id") @db.Uuid
  membershipId  String?      @map("membership_id") @db.Uuid
  amount        Decimal      @db.Decimal(10, 2)
  status        ChargeStatus @default(PENDIENTE)
  receiptNumber String?      @unique @map("receipt_number") @db.VarChar(30)
  concept       String?      @db.VarChar(150)
  last4         String?      @db.VarChar(4)
  paidAt        DateTime?    @map("paid_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user       User        @relation("UserCharges", fields: [userId], references: [id], onDelete: Cascade)
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([createdAt])
  @@map("charges")
}

// ---------------------------------------------------------------
// H4 & H5 — Modelo de Reservas de Clases (Tasks DB-4.1 / DB-5.1)
// ---------------------------------------------------------------

enum ReservationStatus {
  ACTIVA
  CANCELADA

  @@map("reservation_status")
}

enum SessionState {
  PROGRAMADA @map("programada")
  CANCELADA  @map("cancelada")
  FINALIZADA @map("finalizada")

  @@map("session_state")
}

model ClassSession {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String       @db.VarChar(100)
  trainerId          String       @map("trainer_id") @db.Uuid
  date               DateTime     @db.Date
  startTime          String       @map("start_time") @db.VarChar(5) // Formato "HH:mm"
  duration           Int          @map("duration_minutes")
  maxCapacity        Int          @map("max_capacity")
  status             SessionState @default(PROGRAMADA)
  cancellationReason String?      @map("cancellation_reason") @db.VarChar(255)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  trainer      User          @relation("TrainerSessions", fields: [trainerId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([date])
  @@index([trainerId, date])
  @@map("class_sessions")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  sessionId          String            @map("session_id") @db.Uuid
  memberId           String            @map("member_id") @db.Uuid
  status             ReservationStatus @default(ACTIVA)
  canceledAt         DateTime?         @map("canceled_at")
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  User         @relation("UserReservations", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId], name: "sessionId_memberId_unique")
  @@index([sessionId])
  @@index([memberId])
  @@map("reservations")
}

// ---------------------------------------------------------------
// H7 & H8 — Bloques de disponibilidad y Sesiones Personales (dev)
// ---------------------------------------------------------------

model TrainerSlot {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  trainer         User             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  personalSession PersonalSession?

  @@unique([trainerId, date, startTime])
  @@index([trainerId])
  @@index([date])
  @@map("trainer_slots")
}

model PersonalSession {
  id        String        @id @default(uuid()) @db.Uuid
  slotId    String        @unique @map("slot_id") @db.Uuid
  memberId  String        @map("member_id") @db.Uuid
  status    SessionStatus @default(Agendada)
  createdAt DateTime      @default(now()) @map("created_at")

  slot   TrainerSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  member User        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("personal_sessions")
}

enum SessionStatus {
  Agendada
  Completada
  Cancelada

  @@map("session_status")
}