# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=si_be_boilerplate
POSTGRES_PORT=5432

# Postgres local de desarrollo y pruebas (docker-compose.test.yml).
# Opcional: solo hace falta si usás la Opción C del README.
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=postgres
TEST_POSTGRES_DB=si_be_boilerplate_test
TEST_POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Prisma
# Al correr la API en el host contra el Postgres de Docker, el host es localhost.
# Al correr la API dentro de docker-compose, docker-compose.yml sobreescribe
# esta variable para apuntar al servicio `postgres` en lugar de `localhost`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/si_be_boilerplate?schema=public

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Servicio de Notificaciones (Módulo 9)
# Se invoca al cancelar una clase. El envío es fire-and-forget: si no responde,
# la cancelación igual se confirma.
# ---------------------------------------------------------------------------
NOTIFICATIONS_URL=http://localhost:3000/api/notifications/send
