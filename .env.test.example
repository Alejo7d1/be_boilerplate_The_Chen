# Entorno de los tests e2e.
#
# Copiá este archivo a .env.test antes de correr `npm run test:e2e`:
#   cp .env.test.example .env.test
#
# Apunta a la base de docker-compose.test.yml (puerto 5433), distinta de la de
# desarrollo, para que la suite no ensucie los datos de prueba manuales.
NODE_ENV=test
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/si_be_boilerplate_test?schema=public

# Solo para tests: no usar este secreto fuera de la suite.
JWT_SECRET=test-only-secret-0123456789abcdefghijklmnop
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
